      - url: "{{ _.ip }}/execute_scrap"
        name: Trabalhista
        meta:
          id: req_ffb11e2b9d594e6595729a3212a3acb6
          created: 1747756460184
          modified: 1770053469515
          isPrivate: false
          description: ""
          sortKey: -1748275329285
        method: POST
        body:
          mimeType: application/json
          text: >-
            {
                "options": {
                    "headless": true,
                    "slow_mo": 250,
                    "args": [
                        "--disable-dev-shm-usage",
                        "--disable-blink-features=AutomationControlled"
                    ]
                },

                "steps": [
                    {
                        "func": "go_to",
                        "args": {
                            "url": "https://cndt-certidao.tst.jus.br/inicio.faces"
                        }
                    },           
                    {
                        "func": "click",
                        "args": {
                            "xpath": "//*[@id='corpo']/div/div[2]/input[1]"
                        }
                    },
                    {
                        "func": "insert",
                        "args": {
                            "xpath": "//*[@id='gerarCertidaoForm:cpfCnpj']",
                            "text": "inserir cnpj aqui"
                        }
                    },
                    {
                        "func": "wait",
                        "args":{
                            "seconds": 5
                        }
                        
                    },
                    {
                        "func": "captcha_solver",
                        "args": {
                            "api_key": "a7828fac8aea394fa604918d7dc0660d",
                            "img_xpath": "//*[@id='idImgBase64']",
                            "input_xpath": "//*[@id='idCampoResposta']"
                        }
                    },
                    {
                        "func": "save_file",
                        "args": {
                            "xpath": "//*[@id='gerarCertidaoForm:btnEmitirCertidao']",
                            "path": "/pdf"
                        }
                    }        
                ]
            }
        headers:
          - name: Content-Type
            value: application/json
          - name: User-Agent
            value: insomnia/11.1.0
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
